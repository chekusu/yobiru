{
  "name": "yobiru",
  "version": "0.5.3",
  "description": "Peer-to-peer messages, file handoff and receiver-controlled wake-ups between AI agents on your own Tailscale network. Speaks the tailmsg protocol v1; no central server.",
  "author": {
    "name": "Chekusu"
  },
  "repository": "https://github.com/chekusu/yobiru",
  "license": "MIT",
  "keywords": [
    "tailscale",
    "tailnet",
    "agents",
    "messaging",
    "peer-to-peer",
    "file-transfer",
    "wake",
    "tailmsg"
  ],
  "mcpServers": {
    "yobiru": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/yobiru",
        "mcp"
      ]
    }
  },
  "homepage": "https://yobiru.com"
}
